# ========================================================================
# SECRETS CONFIGURATION - EXAMPLE TEMPLATE
# ========================================================================
#
# INSTRUCTIONS:
# 1. Copy this file: cp secrets.env.example secrets.env
# 2. Edit secrets.env and replace ALL values with your actual secrets
# 3. Keep secrets.env LOCAL ONLY - never commit to version control
# 4. Run ./generate-userdata.sh to generate user-data from template
#
# ========================================================================

# ------------------------------------------------------------------------
# SYSTEM CONFIGURATION
# ------------------------------------------------------------------------
# System hostname (e.g., homecloud, myserver)
HOSTNAME="CHANGE_ME_hostname"

# ------------------------------------------------------------------------
# USER CREDENTIALS
# ------------------------------------------------------------------------

# NOTE: The default admin user 'pirate' has a fixed password 'hypriot' which
# MUST be changed and will be enforced on first SSH login through cloud-init
# configuration.

# GitHub username for SSH key import (cloud-init will import public keys
# from github.com/<username>.keys)
GITHUB_USER="CHANGE_ME_github_username"

# ------------------------------------------------------------------------
# SAMBA USER CONFIGURATION
# ------------------------------------------------------------------------

# User 1 configuration (Samba share user)
USER1="CHANGE_ME_user1_name"
USER1_SAMBA_PASSWORD="CHANGE_ME_user1_samba_password"

# User 2 configuration (Samba share user)
USER2="CHANGE_ME_user2_name"
USER2_SAMBA_PASSWORD="CHANGE_ME_user2_samba_password"

# ------------------------------------------------------------------------
# NETWORK CONFIGURATION
# ------------------------------------------------------------------------

# Static network configuration (Pi IP in Privat VLAN)
STATIC_IP="192.168.10.10"
GATEWAY_IP="192.168.10.1"
DNS_SERVERS="[192.168.10.1, 8.8.8.8]"

# ------------------------------------------------------------------------
# VLAN CONFIGURATION
# ------------------------------------------------------------------------

# VLAN IDs for network segmentation
VLAN_PRIVAT="10"
# Manually configure via Fritz!Box dhcp-service
#PRIV_STATIC_START="192.168.10.100"
#PRIV_STATIC_END="192.168.10.200"

VLAN_IOT="20"
VLAN_GUEST="30"

# DHCP ranges for IoT VLAN (dnsmasq managed)
IOT_DHCP_START="192.168.20.50"
IOT_DHCP_END="192.168.20.200"

# DHCP ranges for Guest VLAN (dnsmasq managed)
GUEST_DHCP_START="192.168.30.50"
GUEST_DHCP_END="192.168.30.200"

# Upstream DNS server (typically your router, e.g., FritzBox)
UPSTREAM_DNS_SERVER="192.168.10.10"

# Local domain name for dnsmasq
DOMAIN="home"

# ------------------------------------------------------------------------
# DYNAMIC DNS CONFIGURATION
# ------------------------------------------------------------------------

# Your dynamic DNS hostname (e.g., myserver.spdns.eu)
DDNS_HOSTNAME="CHANGE_ME_subdomain.spdns.eu"

# Your dynamic DNS update token from provider
DDNS_TOKEN="CHANGE_ME_dyndns_token"

# ========================================================================
# IMPORTANT SECURITY NOTES:
# - This file contains sensitive credentials
# - Never commit secrets.env to version control
# - Keep it in a secure location
# - Use strong, unique passwords for all accounts
# ========================================================================
